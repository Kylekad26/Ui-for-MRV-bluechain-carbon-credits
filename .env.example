# BlueChain Environment Variables Example

# Blockchain configuration
NETWORK=local
# SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
# PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
MINT_API_KEY=bluecarbon_oracle_2025_secure

# Firebase Configuration (for frontend auth)
# Copy these values from your Firebase Project Console -> Project Settings -> General -> Web App
FIREBASE_API_KEY=your_api_key_here
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
